# Docker ignore file for Gazera
# Excludes unnecessary files from Docker build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
.hypothesis/
*.cover
.tox/
.venv/
venv/
env/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Documentation
docs/
*.md
!README.md

# Tests
tests/
*.test
test_*

# Logs and outputs
logs/
*.log
outputs/
checkpoints/

# Data
data/raw/*
data/processed/*
samples/

# Node
node_modules/
.next/
ui/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Environment
.env
.env.local
.env.*.local

# Temporary
*.tmp
*.bak
.cache/
